{
  "name": "move-reminder",
  "version": "0.1.0",
  "description": "Erinnerung, sich am Arbeitsplatz regelmäßig zu bewegen",
  "main": "src/main.js",
  "private": true,
  "author": "Daniel Reiter",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --universal",
    "dist:win": "electron-builder --win nsis zip --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.reiter.movereminder",
    "productName": "Bewegungs-Reminder",
    "files": [
      "src/**/*",
      "assets/**/*",
      "build-resources/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build-resources/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Gigex42",
        "repo": "move-reminder"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
